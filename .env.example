# Copy to .env and set your own MongoDB Atlas URI.
# Never commit .env or share your database password.
MONGODB_URI=
MONGODB_DATABASE=gods_eye
MONGODB_COLLECTION=detection_events
CAMERA_INDEX=0
MATCH_THRESHOLD=0.363
ALERT_COOLDOWN_SECONDS=30
LOCATION_MAX_AGE_SECONDS=60
APP_HOST=127.0.0.1
APP_PORT=8000
